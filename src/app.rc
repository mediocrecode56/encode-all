#include <windows.h>
#include "version.h"
1 ICON "../assets/encodeall.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION EA_VERSION_NUM
PRODUCTVERSION EA_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Encode All"
      VALUE "FileDescription", "Encode All"
      VALUE "FileVersion", EA_VERSION
      VALUE "ProductName", "Encode All"
      VALUE "ProductVersion", EA_VERSION
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "EncodeAll.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
